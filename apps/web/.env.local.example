# =============================================================================
# RiskForge Web — local environment
# =============================================================================
# Copy to `.env.local` (gitignored) before running `pnpm dev`.
# These values override the root .env.example for the Next.js app.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# =============================================================================

# Base URL of the RiskForge API server.
# Default: http://localhost:3001 (matches PORT=3001 in root .env.example).
# In production, set to your deployed API URL (e.g. https://api.riskforge.io).
NEXT_PUBLIC_API_URL=http://localhost:3001
