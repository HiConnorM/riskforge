# =============================================================================
# RiskForge — environment configuration
# =============================================================================
# Copy to `.env` and fill in. Never commit a real `.env`; it is gitignored.
#
# All values are validated at startup by `@riskforge/config` (Zod). Any
# missing / malformed value will cause the API and worker to exit fast with
# a descriptive error.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------

# `development` enables verbose error responses; `production` redacts.
NODE_ENV=development

# Logger verbosity. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Engine semantic version surfaced on every job record and the /health
# endpoint. Bump on any change that affects simulation output so historical
# results remain reproducible.
ENGINE_VERSION=1.0.0

# ---- API --------------------------------------------------------------------

# TCP port the Fastify listener binds to.
# NOTE: Next.js dev server uses port 3000 by default. Set the API to 3001
# to avoid conflicts when running both locally.
PORT=3001

# ---- Worker -----------------------------------------------------------------

# Number of jobs the worker processes in parallel. Tune against CPU count;
# each simulation is CPU-bound. Soft cap: ~ (vCPUs).
WORKER_CONCURRENCY=4

# ---- Redis ------------------------------------------------------------------

# Connection string for BOTH the BullMQ queue and the cache. Use a dedicated
# Redis instance in production — sharing with other services risks key
# collisions despite the `riskforge:` namespace.
REDIS_URL=redis://localhost:6379

# ---- Database (Postgres) ----------------------------------------------------

# Required for Prisma. Format: postgresql://USER:PASS@HOST:PORT/DB
# Leave unset only if you are running the API/worker without persistence
# (Phase 2 mode — results live in Redis only).
# DATABASE_URL=postgresql://riskforge:riskforge@localhost:5432/riskforge

# ---- Result cache -----------------------------------------------------------

# How long completed simulation results live in Redis before eviction.
# 24h is the default; raise for support / audit replay windows.
RESULT_TTL_SECONDS=86400

# ---- Compute limits ---------------------------------------------------------
#
# Per-plan Monte Carlo path caps. The API enforces MAX_PATHS_ANONYMOUS today;
# the other tiers become active when authentication ships.

MAX_PATHS_ANONYMOUS=5000
MAX_PATHS_FREE=10000
MAX_PATHS_PRO=500000
MAX_PATHS_ENTERPRISE=5000000

# ---- Frontend (Next.js) ----------------------------------------------------
#
# These NEXT_PUBLIC_* variables are inlined into the browser bundle at build
# time. Change them in apps/web/.env.local (never commit that file).

# Base URL for the RiskForge API. Must match the PORT above.
# In production, replace with your deployed API URL.
NEXT_PUBLIC_API_URL=http://localhost:3001
